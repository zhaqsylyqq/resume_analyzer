# Copy to .env and fill in. Never commit .env.
# Check it with: python -m app.check_config   (secrets are never printed)
# Any secret below can come from a file instead: NAME_FILE=/path/to/file (Docker/Kubernetes secrets).

# development (default) | production | test. Production requires the AI key, HTTPS-only
# cookies and an existing session secret. scripts/serve_public.ps1 sets production itself.
# APP_ENV=development
# Folder for the database and the generated secret (default: instance/)
# DATA_DIR=
# Seconds a stopping server waits for resumes being analyzed (default 25)
# SHUTDOWN_TIMEOUT=25

# --- AI provider ---------------------------------------------------------------------
# "deepseek" (recommended, cheapest; prepaid balance) or "gemini".
LLM_PROVIDER=deepseek

# --- DeepSeek (https://platform.deepseek.com) -----------------------------------------
# Required for DeepSeek: API key. Top up the balance at https://platform.deepseek.com/top_up
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional: model (thinking mode is switched off in code to save tokens)
DEEPSEEK_MODEL=deepseek-flash
# Optional: comma-separated fallback chain, tried while the main model is rate-limited
# DEEPSEEK_FALLBACK_MODEL=
# Optional: API address; change only when going through a proxy
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Gemini (alternative: set LLM_PROVIDER=gemini and uncomment) ----------------------
# Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# Cheapest "flash-lite" tier; accurate enough for structured JSON.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Fallback chain while the main model is rate-limited, overloaded or out of daily quota.
# On the free tier every model has its own daily quota (~20 requests).
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Shared by both providers --------------------------------------------------------
# Parallel AI requests per batch
GEMINI_CONCURRENCY=2
# Retries per request on 429/5xx before a resume is marked failed
GEMINI_MAX_RETRIES=5

# Optional: initial invite code (admins switch sign-up on/off and change the code in the app)
# INVITE_CODE=
# Optional: initial resumes per recruiter per 24 h (0 = no limit; admins change it in the app)
# DAILY_RESUME_LIMIT=30
# Optional: initial AI vacancy checks per recruiter per 24 h (0 = no limit; admins change it in the app)
# DAILY_AI_CHECK_LIMIT=20

# Optional: sessions not changed for this many days are deleted (0 = keep forever)
# RETENTION_DAYS=90

# --- Encrypted offsite backup (QW-01, scripts/backup_offsite.py) ----------------------
# Folder OUTSIDE this disk: a USB drive, a NAS, or a synced folder of a storage provider
# that keeps data in Kazakhstan. Resumes are personal data: never a foreign cloud drive.
# BACKUP_OFFSITE_DIR=E:\hrscreen-backups
# Create once with: python scripts/backup_offsite.py --generate-key
# Keep a copy in a password manager (two people): without it backups cannot be read.
# BACKUP_KEY=

# Optional: Cloudflare Tunnel token for scripts/serve_public.ps1 and deploy/docker-compose.yml
# (see docs/DEPLOY.md). Secret: never commit it.
# TUNNEL_TOKEN=

# Optional: Flask session secret, at least 32 characters (python -c "import secrets; print(secrets.token_hex(32))").
# If unset, one is generated in instance/.secret_key (outside production only).
FLASK_SECRET_KEY=

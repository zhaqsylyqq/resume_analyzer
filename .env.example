# Copy to .env and fill in. Never commit .env.

# --- AI provider ---------------------------------------------------------------------
# "deepseek" (recommended, cheapest; prepaid balance) or "gemini".
LLM_PROVIDER=deepseek

# --- DeepSeek (https://platform.deepseek.com) -----------------------------------------
# Required for DeepSeek: API key. Top up the balance at https://platform.deepseek.com/top_up
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional: model (thinking mode is switched off in code to save tokens)
DEEPSEEK_MODEL=deepseek-flash
# Optional: comma-separated fallback chain, tried while the main model is rate-limited
# DEEPSEEK_FALLBACK_MODEL=
# Optional: API address; change only when going through a proxy
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Gemini (alternative: set LLM_PROVIDER=gemini and uncomment) ----------------------
# Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# Cheapest "flash-lite" tier; accurate enough for structured JSON.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Fallback chain while the main model is rate-limited, overloaded or out of daily quota.
# On the free tier every model has its own daily quota (~20 requests).
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Shared by both providers --------------------------------------------------------
# Parallel AI requests per batch
GEMINI_CONCURRENCY=2
# Retries per request on 429/5xx before a resume is marked failed
GEMINI_MAX_RETRIES=5

# Optional: code for self sign-up at /register (new users become recruiters); empty = off
# INVITE_CODE=

# Optional: sessions not changed for this many days are deleted (0 = keep forever)
# RETENTION_DAYS=90

# Optional: Flask session secret. If unset, one is generated in instance/.secret_key
FLASK_SECRET_KEY=

# Copy to .env and fill in. Never commit .env.

# Required: Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Required: model used for extraction, scoring and bias checks
GEMINI_MODEL=gemini-3.8-flash
# Optional: comma-separated fallback chain, tried in order while the main model is
# rate-limited, overloaded or out of daily quota. On the free tier every model has its
# own daily quota (~20 requests), so each extra model adds ~10 resumes per day.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional: parallel Gemini requests per batch (keep low on the free tier)
GEMINI_CONCURRENCY=2
# Optional: retries per request on 429/5xx before a resume is marked failed
# (each waits up to 60 s; the free tier often needs several)
GEMINI_MAX_RETRIES=10

# Optional: Flask session secret. If unset, one is generated in instance/.secret_key
FLASK_SECRET_KEY=

# Copy to .env and fill in. Never commit .env.

# Required: Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Required: model used for extraction, scoring and bias checks
GEMINI_MODEL=gemini-3.8-flash
# Optional: used when the main model is overloaded (HTTP 503)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Optional: parallel Gemini requests per batch (keep low on the free tier)
GEMINI_CONCURRENCY=2

# Optional: Flask session secret. If unset, one is generated in instance/.secret_key
FLASK_SECRET_KEY=
